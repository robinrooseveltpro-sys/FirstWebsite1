    function clearAll() {
      for (const id of FIELD_IDS) {
        document.getElementById(id).value = "";
      }

      $("#ctaLabel").value = "Book a meeting";
      $("#templateSelect").value = "modern";
      $("#fontSelect").value = FONT_OPTIONS[0];
      $("#accentColor").value = "#2457d6";
      $("#fontSize").value = "13";

      render();
      setStatus("Signature details cleared.");
    }

    FIELD_IDS.forEach(id => {
      const element = document.getElementById(id);
      element.addEventListener("input", render);
      element.addEventListener("change", render);
    });

    ["templateSelect", "fontSelect", "accentColor", "fontSize"].forEach(id => {
      document.getElementById(id).addEventListener("change", render);
      document.getElementById(id).addEventListener("input", render);
    });

    $$("[data-template]").forEach(button => {
      button.addEventListener("click", () => {
        $("#templateSelect").value = button.dataset.template;
        render();
      });
    });

    $("#copyFormattedButton").addEventListener("click", copyFormatted);
    $("#copyHtmlButton").addEventListener("click", copyHtmlCode);
    $("#copyPlainButton").addEventListener("click", copyPlainText);

    $("#downloadButton").addEventListener("click", () => {
      if (!requireName()) return;

      const data = getData();
      const html = buildSignature(data);
      const documentHtml = exportDocument(html);

      downloadFile(
        fileNameFromName(data.fullName) + "-email-signature.html",
        documentHtml,
        "text/html;charset=utf-8"
      );

      setStatus("HTML file downloaded. Open it in a browser and copy the signature if needed.");
    });

    $("#sampleButton").addEventListener("click", loadExample);
    $("#clearButton").addEventListener("click", clearAll);

    $("#selectHtmlButton").addEventListener("click", () => {
      htmlOutput.focus();
      htmlOutput.select();
      setStatus("HTML code selected. Use your device's copy command.");
    });

    $("#selectPlainButton").addEventListener("click", () => {
      plainOutput.focus();
      plainOutput.select();
      setStatus("Plain-text content selected. Use your device's copy command.");
    });

    $("#year").textContent = new Date().getFullYear();

    render();
  </script>
</body>
</html>
