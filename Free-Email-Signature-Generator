  <script>
    "use strict";

    const $ = (selector, root = document) => root.querySelector(selector);
    const $$ = (selector, root = document) => [...root.querySelectorAll(selector)];

    const status = $("#status");
    const preview = $("#signaturePreview");
    const htmlOutput = $("#htmlOutput");
    const plainOutput = $("#plainOutput");

    const FIELD_IDS = [
      "fullName",
      "jobTitle",
      "company",
      "department",
      "emailAddress",
      "phone",
      "website",
      "address",
      "tagline",
      "logoUrl",
      "logoAlt",
      "linkedin",
      "instagram",
      "xProfile",
      "bookingUrl",
      "ctaLabel",
      "disclaimer"
    ];

    const TEMPLATE_NAMES = {
      classic: "Classic",
      modern: "Modern",
      compact: "Compact",
      corporate: "Corporate"
    };

    const FONT_OPTIONS = [
      "Arial, Helvetica, sans-serif",
      "Verdana, Geneva, sans-serif",
      "Tahoma, Geneva, sans-serif",
      "Georgia, serif"
    ];

    function escapeHTML(value) {
      return String(value ?? "").replace(/[&<>"']/g, char => ({
        "&": "&amp;",
        "<": "&lt;",
        ">": "&gt;",
        '"': "&quot;",
        "'": "&#39;"
      })[char]);
    }

    function setStatus(message, isError = false) {
      status.textContent = message;
      status.classList.toggle("error", isError);
    }

    function getData() {
      const data = {};

      for (const id of FIELD_IDS) {
        data[id] = document.getElementById(id).value.trim();
      }

      data.template = $("#templateSelect").value;
      data.font = $("#fontSelect").value;
      data.color = $("#accentColor").value;
      data.fontSize = Number($("#fontSize").value);

      return data;
    }

    function normalizeWebUrl(rawValue, httpsOnly = false) {
      const raw = String(rawValue || "").trim();

      if (!raw) return "";

      // Reject other URL schemes rather than turning them into links.
      if (/^[a-z][a-z\d+.-]*:/i.test(raw) &&
          !/^https?:\/\//i.test(raw)) {
        return null;
      }

      let candidate = raw;

      if (!/^https?:\/\//i.test(candidate)) {
        candidate = "https://" + candidate;
      }

      try {
        const url = new URL(candidate);

        if (!["http:", "https:"].includes(url.protocol)) {
          return null;
        }

        if (httpsOnly && url.protocol !== "https:") {
          return null;
        }

        if (!url.hostname || !url.hostname.includes(".")) {
          return null;
        }

        if (url.username || url.password) {
          return null;
        }

        return url.href;
      } catch {
        return null;
      }
    }

    function displayUrl(raw) {
      const normalized = normalizeWebUrl(raw);
      if (!normalized) return String(raw || "");

      try {
        const url = new URL(normalized);
        let displayed = url.hostname + url.pathname;
        if (url.search) displayed += url.search;
        if (url.hash) displayed += url.hash;
        return displayed.replace(/\/$/, "");
      } catch {
        return String(raw || "");
      }
    }

    function validEmail(raw) {
      const value = String(raw || "").trim();
      if (!value) return false;

      return /^[^\s@<>]+@[^\s@<>]+\.[^\s@<>]+$/.test(value);
    }

    function safePhoneLink(raw) {
      const cleaned = String(raw || "").replace(/[^\d+*#,;]/g, "");
      return cleaned && /\d/.test(cleaned) ? "tel:" + cleaned : "";
    }

    function safeLink(url, label, color, extraStyles = "") {
      if (!url) {
        return escapeHTML(label);
      }

      return `<a href="${escapeHTML(url)}" style="color:${color};text-decoration:none;${extraStyles}">${escapeHTML(label)}</a>`;
    }

    function validateInputs(data) {
      const warnings = [];

      if (!data.fullName) {
        warnings.push("Enter your name before copying or downloading the signature.");
      }

      if (data.emailAddress && !validEmail(data.emailAddress)) {
        warnings.push("The email address looks invalid; it will be displayed as plain text.");
      }

      const urlFields = [
        ["website", "Website"],
        ["linkedin", "LinkedIn"],
        ["instagram", "Instagram"],
        ["xProfile", "X profile"],
        ["bookingUrl", "Booking URL"]
      ];

      for (const [key, label] of urlFields) {
        if (data[key] && !normalizeWebUrl(data[key])) {
          warnings.push(label + " URL is invalid and will not be linked.");
        }
      }

      if (data.logoUrl && !normalizeWebUrl(data.logoUrl, true)) {
        warnings.push("The logo URL must be a valid public HTTPS URL; the logo will be omitted.");
      }

      return warnings;
    }

    function contactItems(data, color, fontSize) {
      const parts = [];

      if (data.emailAddress) {
        if (validEmail(data.emailAddress)) {
          parts.push(
            safeLink(
              "mailto:" + data.emailAddress,
              data.emailAddress,
              color
            )
          );
        } else {
          parts.push(escapeHTML(data.emailAddress));
        }
      }

      if (data.phone) {
        const phoneHref = safePhoneLink(data.phone);
        parts.push(
          phoneHref
            ? safeLink(phoneHref, data.phone, color)
            : escapeHTML(data.phone)
        );
      }

      if (data.website) {
        const url = normalizeWebUrl(data.website);
        parts.push(
          url
            ? safeLink(url, displayUrl(data.website), color)
            : escapeHTML(data.website)
        );
      }

      if (data.address) {
        parts.push(escapeHTML(data.address));
      }

      const separator = `<span style="color:#b8c1ce;padding:0 5px;">|</span>`;

      return parts.map(part => part + "").join(separator);
    }

    function socialLinks(data, color) {
      const profiles = [
        ["LinkedIn", data.linkedin],
        ["Instagram", data.instagram],
        ["X", data.xProfile]
      ];

      const validProfiles = profiles
        .map(([label, raw]) => ({
          label,
          url: raw ? normalizeWebUrl(raw) : ""
        }))
        .filter(item => item.url);

      if (!validProfiles.length) return "";

      const separator = `<span style="color:#b8c1ce;padding:0 5px;">|</span>`;
      const markup = validProfiles.map(item =>
        safeLink(item.url, item.label, color, "font-weight:600;")
      ).join(separator);

      return `
        <tr>
          <td style="padding:7px 0 0;font-size:12px;line-height:18px;">
            ${markup}
          </td>
        </tr>
      `;
    }

    function renderLogo(data, websiteUrl) {
      const url = data.logoUrl
        ? normalizeWebUrl(data.logoUrl, true)
        : "";

      if (!url) return "";

      const alt = escapeHTML(data.logoAlt || (data.company + " logo") || "Company logo");

      const image = `
        <img src="${escapeHTML(url)}" alt="${alt}"
          width="88" border="0"
          style="display:block;width:88px;max-width:88px;height:auto;border:0;outline:none;text-decoration:none;">
      `;

      return websiteUrl
        ? `<a href="${escapeHTML(websiteUrl)}" style="text-decoration:none;">${image}</a>`
        : image;
    }

    function buildSignature(data) {
      const color = /^#[0-9a-f]{6}$/i.test(data.color)
        ? data.color
        : "#2457d6";

      const font = FONT_OPTIONS.includes(data.font)
        ? data.font
        : FONT_OPTIONS[0];

      const size = [12, 13, 14].includes(data.fontSize)
        ? data.fontSize
        : 13;

      const name = escapeHTML(data.fullName || "Your Name");
      const job = escapeHTML(data.jobTitle);
      const company = escapeHTML(data.company);
      const department = escapeHTML(data.department);
      const tagline = escapeHTML(data.tagline);
      const disclaimer = escapeHTML(data.disclaimer);
      const companyDetails = [department, company].filter(Boolean).join(" · ");

      const titleLine = [job, companyDetails].filter(Boolean).join(" | ");

      const websiteUrl = data.website
        ? normalizeWebUrl(data.website)
        : "";

      const logoHTML = renderLogo(data, websiteUrl);

      const nameMarkup = `
        <tr>
          <td style="padding:0 0 3px;font-family:${font};font-size:18px;line-height:23px;font-weight:700;color:#172033;">
            ${name}
          </td>
        </tr>
      `;

      const titleMarkup = titleLine
        ? `<tr><td style="padding:0 0 5px;font-family:${font};font-size:${size}px;line-height:19px;color:#4b5565;">${escapeHTML(titleLine)}</td></tr>`
        : "";

      const taglineMarkup = tagline
        ? `<tr><td style="padding:0 0 7px;font-family:${font};font-size:${size}px;line-height:19px;color:#667085;font-style:italic;">${tagline}</td></tr>`
        : "";

      const contacts = contactItems(data, color, size);

      const contactsMarkup = contacts
        ? `<tr><td style="padding:7px 0 0;font-family:${font};font-size:${size}px;line-height:21px;color:#475467;overflow-wrap:anywhere;">${contacts}</td></tr>`
        : "";

      const socialMarkup = socialLinks(data, color);

      const bookingUrl = data.bookingUrl
        ? normalizeWebUrl(data.bookingUrl)
        : "";

      const ctaLabel = data.ctaLabel || "Book a meeting";

      const ctaMarkup = bookingUrl
        ? `<tr><td style="padding:10px 0 0;font-family:${font};font-size:${size}px;line-height:19px;">${safeLink(bookingUrl, ctaLabel, color, "font-weight:700;")}</td></tr>`
        : "";

      const disclaimerMarkup = disclaimer
        ? `<tr><td style="padding:10px 0 0;font-family:${font};font-size:10px;line-height:15px;color:#7b8493;font-style:italic;">${disclaimer}</td></tr>`
        : "";

      const separatorMarkup = `
        <tr>
          <td style="height:1px;padding:0 0 7px;font-size:1px;line-height:1px;border-bottom:1px solid #dce3ed;">
            &nbsp;
          </td>
        </tr>
      `;

      let innerRows;

      if (data.template === "compact") {
        const compactTitle = [job, companyDetails].filter(Boolean).join(" · ");

        innerRows = `
          <tr>
            <td style="padding:0 0 4px;font-family:${font};font-size:15px;line-height:20px;color:#172033;">
              <strong>${name}</strong>
              ${compactTitle ? `<span style="color:#7b8493;"> · ${escapeHTML(compactTitle)}</span>` : ""}
            </td>
          </tr>
          ${taglineMarkup}
          ${contactsMarkup}
          ${socialMarkup}
          ${ctaMarkup}
          ${disclaimerMarkup}
        `;
      } else {
        innerRows = `
          ${nameMarkup}
          ${titleMarkup}
          ${taglineMarkup}
          ${separatorMarkup}
          ${contactsMarkup}
          ${socialMarkup}
          ${ctaMarkup}
          ${disclaimerMarkup}
        `;
      }

      const baseTableStyles =
        `border-collapse:collapse;border-spacing:0;font-family:${font};font-size:${size}px;color:#344054;`;

      if (data.template === "corporate" && logoHTML) {
        return `
          <table role="presentation" cellpadding="0" cellspacing="0" border="0"
            style="${baseTableStyles}max-width:560px;">
            <tr>
              <td valign="top" style="padding:2px 15px 0 0;vertical-align:top;width:105px;">
                ${logoHTML}
              </td>
              <td valign="top" style="padding:0;vertical-align:top;">
                <table role="presentation" cellpadding="0" cellspacing="0" border="0"
                  style="${baseTableStyles}">
                  ${innerRows}
                </table>
              </td>
            </tr>
          </table>
        `;
      }

      if (data.template === "modern") {
        return `
          <table role="presentation" cellpadding="0" cellspacing="0" border="0"
            style="${baseTableStyles}max-width:560px;">
            <tr>
              <td valign="top" style="padding:1px 0 1px 13px;border-left:3px solid ${color};vertical-align:top;">
                ${logoHTML ? `<div style="padding:0 0 8px;">${logoHTML}</div>` : ""}
                <table role="presentation" cellpadding="0" cellspacing="0" border="0"
                  style="${baseTableStyles}">
                  ${innerRows}
                </table>
              </td>
            </tr>
          </table>
        `;
      }

      return `
        <table role="presentation" cellpadding="0" cellspacing="0" border="0"
          style="${baseTableStyles}max-width:560px;">
          ${logoHTML ? `<tr><td style="padding:0 0 10px;">${logoHTML}</td></tr>` : ""}
          ${innerRows}
        </table>
      `;
    }

    function toPlainText(html) {
      const container = document.createElement("div");
      container.innerHTML = html;

      container.querySelectorAll("br").forEach(node => {
        node.replaceWith("\n");
      });

      container.querySelectorAll("tr").forEach(node => {
        node.append(document.createTextNode("\n"));
      });

      container.querySelectorAll("a").forEach(link => {
        const href = link.getAttribute("href") || "";

        if (/^https?:\/\//i.test(href) &&
            !link.textContent.includes(href)) {
          link.append(document.createTextNode(" (" + href + ")"));
        }
      });

      return (container.innerText || container.textContent || "")
        .replace(/\n[ \t]*\n[ \t]*\n/g, "\n\n")
        .replace(/[ \t]+\n/g, "\n")
        .trim();
    }

    function render() {
      const data = getData();
      const signatureHtml = buildSignature(data);
      const warnings = validateInputs(data);

      preview.innerHTML = signatureHtml;
      htmlOutput.value = signatureHtml;
      plainOutput.value = toPlainText(signatureHtml);

      if (warnings.length) {
        setStatus(warnings.join(" "), !data.fullName);
      } else {
        setStatus("Preview updated. Your signature is ready to review.");
      }
    }

    function exportDocument(signatureHtml) {
      return `<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Email Signature</title>
</head>
<body style="margin:24px;background:#ffffff;">
<!-- Copy the signature below into your email client's signature editor. -->
${signatureHtml}
</body>
</html>`;
    }

    function fileNameFromName(name) {
      const result = String(name || "email-signature")
        .normalize("NFKD")
        .replace(/[^\w-]+/g, "-")
        .replace(/^-+|-+$/g, "")
        .slice(0, 50);

      return result || "email-signature";
    }

    function downloadFile(filename, text, mimeType) {
      const blob = new Blob([text], { type: mimeType });
      const url = URL.createObjectURL(blob);
      const link = document.createElement("a");

      link.href = url;
      link.download = filename;
      link.style.display = "none";

      document.body.append(link);
      link.click();
      link.remove();

      window.setTimeout(() => URL.revokeObjectURL(url), 1200);
    }

    function requireName() {
      const name = $("#fullName").value.trim();

      if (!name) {
        setStatus("Enter your full name before copying or downloading.", true);
        $("#fullName").focus();
        return false;
      }

      return true;
    }

    function legacyCopyRichHtml(html) {
      const temporary = document.createElement("div");
      temporary.contentEditable = "true";
      temporary.setAttribute("aria-hidden", "true");
      temporary.style.position = "fixed";
      temporary.style.left = "-99999px";
      temporary.style.top = "0";
      temporary.style.width = "600px";
      temporary.style.background = "#ffffff";
      temporary.innerHTML = html;

      document.body.append(temporary);

      const selection = window.getSelection();
      const range = document.createRange();

      range.selectNodeContents(temporary);
      selection.removeAllRanges();
      selection.addRange(range);

      let success = false;

      try {
        success = document.execCommand("copy");
      } catch {
        success = false;
      }

      selection.removeAllRanges();
      temporary.remove();

      return success;
    }

    async function copyFormatted() {
      if (!requireName()) return;

      const data = getData();
      const html = buildSignature(data);
      const plain = toPlainText(html);

      try {
        if (navigator.clipboard &&
            window.isSecureContext &&
            typeof ClipboardItem !== "undefined") {
          const htmlBlob = new Blob([html], { type: "text/html" });
          const textBlob = new Blob([plain], { type: "text/plain" });

          await navigator.clipboard.write([
            new ClipboardItem({
              "text/html": htmlBlob,
              "text/plain": textBlob
            })
          ]);

          setStatus("Formatted signature copied. Paste it into your email signature editor, then test it.");
          return;
        }
      } catch {
        // Continue with the browser's legacy rich-text copy method.
      }

      if (legacyCopyRichHtml(html)) {
        setStatus("Formatted signature copied. Paste it into your email signature editor, then test it.");
      } else {
        setStatus(
          "Automatic rich copying was unavailable. Select the preview with your mouse, copy it, and paste into your email editor.",
          true
        );
      }
    }

    async function copyHtmlCode() {
      if (!requireName()) return;

      try {
        if (navigator.clipboard && window.isSecureContext) {
          await navigator.clipboard.writeText(htmlOutput.value);
        } else {
          htmlOutput.focus();
          htmlOutput.select();

          if (!document.execCommand("copy")) {
            throw new Error("Select the code manually and copy it.");
          }
        }

        setStatus("HTML code copied.");
      } catch (error) {
        setStatus(error.message || "Could not copy the HTML code.", true);
      }
    }

    async function copyPlainText() {
      if (!requireName()) return;

      try {
        if (navigator.clipboard && window.isSecureContext) {
          await navigator.clipboard.writeText(plainOutput.value);
        } else {
          plainOutput.focus();
          plainOutput.select();

          if (!document.execCommand("copy")) {
            throw new Error("Select the text manually and copy it.");
          }
        }

        setStatus("Plain-text signature copied.");
      } catch (error) {
        setStatus(error.message || "Could not copy plain text.", true);
      }
    }

    function loadExample() {
