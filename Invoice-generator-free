  <script>
    (() => {
      "use strict";

      const MAX_ITEMS = 50;
      const MAX_FIELD_AMOUNT = 1e12;
      const MAX_LOGO_BYTES = 1024 * 1024;

      const form = document.getElementById("invoiceForm");
      const itemRows = document.getElementById("itemRows");
      const feedback = document.getElementById("editorFeedback");
      const previewFeedback = document.getElementById("previewFeedback");
      const previewStatus = document.getElementById("previewStatus");

      const documentType = document.getElementById("documentType");
      const documentNumber = document.getElementById("documentNumber");
      const currencyInput = document.getElementById("currency");
      const accentInput = document.getElementById("accentColor");
      const issueDateInput = document.getElementById("issueDate");
      const dueDateInput = document.getElementById("dueDate");
      const businessNameInput = document.getElementById("businessName");
      const clientNameInput = document.getElementById("clientName");
      const discountType = document.getElementById("discountType");
      const discountValue = document.getElementById("discountValue");
      const taxRateInput = document.getElementById("taxRate");
      const otherChargesInput = document.getElementById("otherCharges");
      const amountPaidInput = document.getElementById("amountPaid");
      const logoFileInput = document.getElementById("logoFile");

      const addItemButton = document.getElementById("addItem");
      const prepareButton = document.getElementById("prepareButton");
      const printButton = document.getElementById("printButton");
      const copyButton = document.getElementById("copyButton");
      const downloadCSVButton = document.getElementById("downloadCSVButton");

      let logoDataURL = "";
      let latestData = null;
      let latestCalculation = null;
      let updating = false;

      function el(id) {
        return document.getElementById(id);
      }

      function formatNumber(value, digits = 2) {
        if (!Number.isFinite(value)) {
          return "Not available";
        }

        if (value === 0 || Object.is(value, -0)) {
          return "0";
        }

        return Number(value).toLocaleString(undefined, {
          maximumFractionDigits: digits,
          minimumFractionDigits: 0
        });
      }

      function money(value, currency) {
        return new Intl.NumberFormat(undefined, {
          style: "currency",
          currency,
          minimumFractionDigits: 2,
          maximumFractionDigits: 2
        }).format(value);
      }

      function prettyDate(value) {
        if (!value) {
          return "";
        }

        const match = /^(\d{4})-(\d{2})-(\d{2})$/.exec(value);

        if (!match) {
          return value;
        }

        const date = new Date(
          Number(match[1]),
          Number(match[2]) - 1,
          Number(match[3])
        );

        return Number.isFinite(date.getTime())
          ? new Intl.DateTimeFormat(undefined, {
              year: "numeric",
              month: "short",
              day: "numeric"
            }).format(date)
          : value;
      }

      function showFeedback(message, type) {
        feedback.textContent = message;
        feedback.className = "feedback " + type;
      }

      function clearFeedback() {
        feedback.textContent = "";
        feedback.className = "feedback";
      }

      function showPreviewFeedback(message, type) {
        previewFeedback.textContent = message;
        previewFeedback.className = "feedback " + type;
      }

      function clearPreviewFeedback() {
        previewFeedback.textContent = "";
        previewFeedback.className = "feedback";
      }

      function setText(id, value) {
        el(id).textContent = value == null ? "" : String(value);
      }

      function makeElement(tag, className, text) {
        const element = document.createElement(tag);

        if (className) {
          element.className = className;
        }

        if (text !== undefined && text !== null) {
          element.textContent = String(text);
        }

        return element;
      }

      function safeAmount(value, label, options = {}) {
        const input = value;
        const raw = input.value.trim();
        const number = Number(raw);

        if (
          raw === "" ||
          !Number.isFinite(number) ||
          number < (options.min ?? 0) ||
          number > (options.max ?? MAX_FIELD_AMOUNT)
        ) {
          throw {
            element: input,
            message: label + " must be a valid number between " +
              formatNumber(options.min ?? 0) + " and " +
              formatNumber(options.max ?? MAX_FIELD_AMOUNT) + "."
          };
        }

        return number;
      }

      function setFieldError(input, message) {
        input.setAttribute("aria-invalid", "true");
        input.focus();

        showFeedback(message, "error");
      }

      function clearInvalidFields() {
        form.querySelectorAll("[aria-invalid='true']")
          .forEach(input => input.removeAttribute("aria-invalid"));

        itemRows.querySelectorAll("[aria-invalid='true']")
          .forEach(input => input.removeAttribute("aria-invalid"));
      }

      function setDocumentMode() {
        const estimate = documentType.value === "estimate";

        el("dueDateLabel").textContent = estimate
          ? "Valid until (optional)"
          : "Due date (optional)";

        el("paidField").hidden = estimate;

        if (estimate) {
          el("previewPaidRow").hidden = true;
          el("previewBalanceRow").hidden = true;
          setText("previewTotalLabel", "Estimated total");
        } else {
          el("previewPaidRow").hidden = false;
          el("previewBalanceRow").hidden = false;
          setText("previewTotalLabel", "Invoice total");
        }

        if (documentNumber.value === "INV-001" && estimate) {
          documentNumber.value = "EST-001";
        } else if (documentNumber.value === "EST-001" && !estimate) {
          documentNumber.value = "INV-001";
        }
      }

      function createItemRow(data = {}) {
        if (itemRows.children.length >= MAX_ITEMS) {
          showFeedback("You can add up to " + MAX_ITEMS + " line items.", "error");
          return false;
        }

        const row = document.createElement("tr");

        const descriptionCell = document.createElement("td");
        const quantityCell = document.createElement("td");
        const priceCell = document.createElement("td");
        const amountCell = document.createElement("td");
        const actionCell = document.createElement("td");

        const description = document.createElement("input");
        description.type = "text";
        description.maxLength = 240;
        description.className = "item-description";
        description.value = data.description || "";
        description.placeholder = "Product or service";
        description.setAttribute("aria-label", "Item description");

        const quantity = document.createElement("input");
        quantity.type = "number";
        quantity.min = "0.000001";
        quantity.max = "1000000000";
        quantity.step = "any";
        quantity.inputMode = "decimal";
        quantity.className = "item-quantity";
        quantity.value = data.quantity ?? "1";
        quantity.setAttribute("aria-label", "Item quantity");

        const price = document.createElement("input");
        price.type = "number";
        price.min = "0";
        price.max = String(MAX_FIELD_AMOUNT);
        price.step = "any";
        price.inputMode = "decimal";
        price.className = "item-price";
        price.value = data.price ?? "0";
        price.setAttribute("aria-label", "Unit price");

        const amount = makeElement("span", "line-amount", "—");
        amountCell.appendChild(amount);

        const remove = makeElement("button", "remove-item", "Remove");
        remove.type = "button";

        remove.addEventListener("click", () => {
          if (itemRows.children.length <= 1) {
            showFeedback(
              "At least one line-item row is required. Clear its values or reset the document.",
              "info"
            );
            return;
          }

          row.remove();
          updateItemControls();
          refreshPreview();
        });

        descriptionCell.appendChild(description);
        quantityCell.appendChild(quantity);
        priceCell.appendChild(price);
        actionCell.appendChild(remove);

        row.append(
          descriptionCell,
          quantityCell,
          priceCell,
          amountCell,
          actionCell
        );

        itemRows.appendChild(row);
        updateItemControls();

        return true;
      }

      function updateItemControls() {
        const rows = Array.from(itemRows.querySelectorAll("tr"));

        rows.forEach((row, index) => {
          const remove = row.querySelector(".remove-item");

          remove.disabled = rows.length <= 1;
          remove.setAttribute(
            "aria-label",
            "Remove line item " + (index + 1)
          );
        });

        addItemButton.disabled = rows.length >= MAX_ITEMS;
      }

      function getContactDetails(name, email, phone, address, taxId) {
        const details = [];

        if (email) details.push(email);
        if (phone) details.push(phone);
        if (address) details.push(address);
        if (taxId) details.push("Tax / ID: " + taxId);

        return details.join("\n");
      }

      function collectData(requireIdentity) {
        clearInvalidFields();

        const currencies = [
          "USD", "NPR", "INR", "EUR",
          "GBP", "AUD", "CAD", "NGN"
        ];

        const currency = currencyInput.value;

        if (!currencies.includes(currency)) {
          throw {
            element: currencyInput,
            message: "Choose a supported currency."
          };
        }

        const businessName = businessNameInput.value.trim();
        const clientName = clientNameInput.value.trim();
        const number = documentNumber.value.trim();
        const mode = documentType.value;

        if (requireIdentity && !businessName) {
          throw {
            element: businessNameInput,
            message: "Enter the business or sender name."
          };
        }

        if (requireIdentity && !clientName) {
          throw {
            element: clientNameInput,
            message: "Enter the client or customer name."
          };
        }

        if (requireIdentity && !number) {
          throw {
            element: documentNumber,
            message: "Enter a document number."
          };
        }

        if (mode !== "invoice" && mode !== "estimate") {
          throw {
            element: documentType,
            message: "Choose an invoice or estimate."
          };
        }

        const issueDate = issueDateInput.value;
        const dueDate = dueDateInput.value;

        if (requireIdentity && !issueDate) {
          throw {
            element: issueDateInput,
            message: "Enter the document issue date."
          };
        }

        if (issueDate && dueDate && dueDate < issueDate) {
          throw {
            element: dueDateInput,
            message: "The due date or validity date cannot precede the issue date."
          };
        }

        const subtotalItems = [];

        const rows = Array.from(itemRows.querySelectorAll("tr"));

        for (let index = 0; index < rows.length; index += 1) {
          const row = rows[index];
          const descriptionInput = row.querySelector(".item-description");
          const quantityInput = row.querySelector(".item-quantity");
          const priceInput = row.querySelector(".item-price");

          const description = descriptionInput.value.trim();
          const qtyRaw = quantityInput.value.trim();
          const priceRaw = priceInput.value.trim();

          if (!description && !qtyRaw && !priceRaw) {
            continue;
          }

          if (!description) {
            throw {
              element: descriptionInput,
              message: "Enter a description for line item " + (index + 1) + "."
            };
          }

          const quantity = safeAmount(
            { value: quantityInput },
            "Quantity for line item " + (index + 1),
            { min: 0.000001, max: 1e9 }
          );

          const unitPrice = safeAmount(
            { value: priceInput },
            "Unit price for line item " + (index + 1),
            { min: 0, max: MAX_FIELD_AMOUNT }
          );

          const amount = quantity * unitPrice;

          if (!Number.isFinite(amount) || amount > MAX_FIELD_AMOUNT) {
            throw {
              element: priceInput,
              message: "The amount for line item " + (index + 1) + " is too large."
            };
          }

          subtotalItems.push({
            description,
            quantity,
            unitPrice,
            amount
          });
        }

        if (subtotalItems.length === 0 && requireIdentity) {
          throw {
            element: rows[0].querySelector(".item-description"),
            message: "Add at least one product or service before exporting."
          };
        }

        const subtotal = subtotalItems.reduce((sum, item) => sum + item.amount, 0);

        if (!Number.isFinite(subtotal) || subtotal > MAX_FIELD_AMOUNT) {
          throw {
            element: null,
            message: "The document subtotal exceeds the supported amount."
          };
        }

        const discountValueNumber = safeAmount(
          { value: discountValue },
          "Discount",
          { min: 0, max: discountType.value === "percent" ? 100 : MAX_FIELD_AMOUNT }
        );

        const taxRate = safeAmount(
          { value: taxRateInput },
          "Tax rate",
          { min: 0, max: 100 }
        );

        const otherCharges = safeAmount(
          { value: otherChargesInput },
          "Additional charges",
          { min: 0, max: MAX_FIELD_AMOUNT }
        );

        let discount;

        if (discountType.value === "percent") {
          discount = subtotal * discountValueNumber / 100;
        } else {
          discount = discountValueNumber;

          if (discount > subtotal) {
            throw {
              element: discountValue,
              message: "A fixed discount cannot exceed the items subtotal."
            };
          }
        }

        const taxableAmount = Math.max(0, subtotal - discount);
        const tax = taxableAmount * taxRate / 100;
        const total = taxableAmount + tax + otherCharges;

        const paid = mode === "invoice"
          ? safeAmount(
              { value: amountPaidInput },
              "Amount already paid",
              { min: 0, max: MAX_FIELD_AMOUNT }
            )
          : 0;

        if (mode === "invoice" && paid > total + 0.000001) {
          throw {
            element: amountPaidInput,
            message: "Amount already paid cannot exceed the calculated invoice total."
          };
        }

        const balance = mode === "invoice" ? Math.max(0, total - paid) : total;

        const values = [
          subtotal,
          discount,
          taxableAmount,
          tax,
          otherCharges,
          total,
          paid,
          balance
        ];

        if (!values.every(value =>
          Number.isFinite(value) && Math.abs(value) <= MAX_FIELD_AMOUNT * 2
        )) {
          throw {
            element: null,
            message: "The document totals exceed the supported numeric range."
          };
        }

        const businessEmail = el("businessEmail").value.trim();
        const clientEmail = el("clientEmail").value.trim();

        if (businessEmail && !el("businessEmail").validity.valid) {
          throw {
            element: el("businessEmail"),
            message: "Enter a valid business email address."
          };
        }

        if (clientEmail && !el("clientEmail").validity.valid) {
          throw {
            element: el("clientEmail"),
            message: "Enter a valid client email address."
          };
        }

        return {
          mode,
          number,
          currency,
          accent: accentInput.value,
          issueDate,
          dueDate,
          businessName,
          businessEmail,
          businessPhone: el("businessPhone").value.trim(),
          businessAddress: el("businessAddress").value.trim(),
          businessTaxId: el("businessTaxId").value.trim(),
          clientName,
          clientEmail,
          clientTaxId: el("clientTaxId").value.trim(),
          clientAddress: el("clientAddress").value.trim(),
          items: subtotalItems,
          subtotal,
          discountType: discountType.value,
          discountValue: discountValueNumber,
          discount,
          taxableAmount,
          taxRate,
          tax,
          otherCharges,
          paid,
          total,
          balance,
          paymentInstructions: el("paymentInstructions").value.trim(),
          notes: el("notes").value.trim(),
          logoDataURL,
          identityReady: Boolean(businessName && clientName && number && issueDate)
        };
      }

      function appendTotalRow(container, label, value, options = {}) {
        const row = makeElement(
          "div",
          "invoice-total-row" +
            (options.grand ? " grand-total" : "") +
            (options.balance ? " balance" : "")
        );

        row.append(
          makeElement("span", "", label),
          makeElement("span", "", value)
        );

        if (options.hidden) {
          row.hidden = true;
        }

        container.appendChild(row);
        return row;
      }

      function updatePreview(data, calculation) {
        const paper = el("invoicePaper");
        paper.style.setProperty("--invoice-accent", data.accent);

        setText(
          "previewDocumentTitle",
          data.mode === "estimate" ? "ESTIMATE" : "INVOICE"
        );

        setText("previewNumber", data.number || "—");
        setText("previewIssueDate", prettyDate(data.issueDate) || "—");
        setText("previewDueDate", prettyDate(data.dueDate) || "—");

        el("previewDueRow").hidden = !data.dueDate;

        setText("previewBusinessName", data.businessName || "Your Business");
        setText("previewClientName", data.clientName || "Customer name");
        setText("previewSenderName", data.businessName || "Business name");

        setText(
          "previewBusinessDetails",
          getContactDetails(
            data.businessName,
            data.businessEmail,
            data.businessPhone,
            data.businessAddress,
            data.businessTaxId
          )
        );

        setText(
          "previewClientDetails",
          getContactDetails(
            data.clientName,
            data.clientEmail,
            "",
            data.clientAddress,
            data.clientTaxId
          )
        );

        setText(
          "previewSenderDetails",
          getContactDetails(
            data.businessName,
            data.businessEmail,
            data.businessPhone,
            data.businessAddress,
            data.businessTaxId
          )
        );

        const logo = el("previewLogo");

        if (data.logoDataURL) {
          logo.src = data.logoDataURL;
          logo.alt = (data.businessName || "Business") + " logo";
          logo.hidden = false;
        } else {
          logo.removeAttribute("src");
          logo.hidden = true;
        }

        const previewItems = el("previewItems");
        previewItems.replaceChildren();

        data.items.forEach(item => {
          const row = document.createElement("tr");

          const descriptionCell = document.createElement("td");
          const description = makeElement(
            "div",
            "invoice-item-description",
            item.description
          );

          const qtyCell = makeElement(
            "td",
            "",
            formatNumber(item.quantity, 6)
          );

          const priceCell = makeElement(
            "td",
            "",
            money(item.unitPrice, data.currency)
          );

          const amountCell = makeElement(
            "td",
            "",
            money(item.amount, data.currency)
          );

          descriptionCell.appendChild(description);
          row.append(descriptionCell, qtyCell, priceCell, amountCell);
          previewItems.appendChild(row);
        });

        setText("previewSubtotal", money(calculation.subtotal, data.currency));

        setText(
          "previewDiscountLabel",
          data.discountType === "percent"
            ? "Discount (" + formatNumber(data.discountValue) + "%)"
            : "Discount"
        );

        setText(
          "previewDiscount",
          "−" + money(calculation.discount, data.currency)
        );

        el("previewDiscountRow").hidden = calculation.discount === 0;

        setText(
          "previewTaxLabel",
          "Tax (" + formatNumber(data.taxRate) + "%)"
        );

        setText("previewTax", money(calculation.tax, data.currency));
        el("previewTaxRow").hidden = data.taxRate === 0;

        setText("previewCharges", money(data.otherCharges, data.currency));
        el("previewChargesRow").hidden = data.otherCharges === 0;

        setText(
          "previewTotalLabel",
          data.mode === "estimate" ? "Estimated total" : "Invoice total"
        );

        setText("previewTotal", money(calculation.total, data.currency));

        setText("previewPaid", money(data.paid, data.currency));
        setText("previewBalance", money(calculation.balance, data.currency));

        const invoiceMode = data.mode === "invoice";

        el("previewPaidRow").hidden = !invoiceMode;
        el("previewBalanceRow").hidden = !invoiceMode;

        el("previewPaymentSection").hidden = !data.paymentInstructions;
        setText("previewPayment", data.paymentInstructions);

        el("previewNotesSection").hidden = !data.notes;
        setText("previewNotes", data.notes);

        previewStatus.hidden = data.identityReady;

        if (!data.identityReady) {
          previewStatus.textContent =
            "Complete your business name, customer name, document number, and issue date to enable document export.";
        }

        printButton.disabled = !data.identityReady;
        copyButton.disabled = !data.identityReady;
        downloadCSVButton.disabled = !data.identityReady;
      }

      function refreshPreview() {
        if (updating) {
          return;
        }

        updating = true;

        try {
          const data = collectData(false);
          const calculation = data;

          latestData = data;
          latestCalculation = calculation;

          // The live preview uses already validated arithmetic.
          updatePreview(data, calculation);

          const subtotal = data.subtotal;
          const discount = data.discount;
          const taxable = data.taxableAmount;
          const tax = data.tax;
          const charges = data.otherCharges;
          const total = data.total;

          const numericValues = [
            subtotal, discount, taxable, tax, charges, total
          ];

          if (!numericValues.every(Number.isFinite)) {
            throw {
              element: null,
              message: "Please check the entered amounts."
            };
          }

          clearPreviewFeedback();
        } catch (error) {
          latestData = null;
          latestCalculation = null;

          printButton.disabled = true;
          copyButton.disabled = true;
          downloadCSVButton.disabled = true;

          previewStatus.hidden = false;
          previewStatus.textContent =
            "Preview not refreshed: correct the highlighted field in the editor.";

          if (error && error.element) {
            error.element.setAttribute("aria-invalid", "true");
          }

          showPreviewFeedback(
            error && error.message
              ? error.message
              : "Check the inputs before exporting the document.",
            "error"
          );
        } finally {
          updating = false;
        }
      }

      function prepareDocument() {
        clearFeedback();
        clearInvalidFields();

        try {
          const data = collectData(true);

          latestData = data;
          latestCalculation = data;

          updatePreview(data, data);
          previewStatus.hidden = true;

          showFeedback(
            "Document checked. Review the preview, then print or export the document.",
            "success"
          );

          showPreviewFeedback(
            "Your document is ready to print or export.",
            "success"
          );
        } catch (error) {
          if (error && error.element) {
            setFieldError(error.element, error.message);
          } else {
            showFeedback(
              error && error.message
                ? error.message
                : "Please review the entered details.",
              "error"
            );
          }

          previewStatus.hidden = false;
          previewStatus.textContent =
            "Finish correcting the document details to enable exporting.";
        }
      }

      async function copySummary() {
        if (!latestData || !latestData.identityReady) {
          return;
        }

        const data = latestData;

        const lines = [
          data.mode === "estimate" ? "ESTIMATE" : "INVOICE",
          "Document number: " + data.number,
          "Issue date: " + (data.issueDate || "Not provided"),
          "Due / validity date: " + (data.dueDate || "Not provided"),
          "From: " + data.businessName,
          "To: " + data.clientName,
          "",
          ...data.items.map((item, index) =>
            (index + 1) + ". " + item.description +
            " | Qty: " + formatNumber(item.quantity, 6) +
            " | Unit price: " + money(item.unitPrice, data.currency) +
            " | Amount: " + money(item.amount, data.currency)
          ),
          "",
          "Subtotal: " + money(data.subtotal, data.currency),
          "Discount: " + money(data.discount, data.currency),
          "Tax: " + money(data.tax, data.currency),
          "Additional charges: " + money(data.otherCharges, data.currency),
          "Total: " + money(data.total, data.currency)
        ];

        if (data.mode === "invoice") {
          lines.push(
            "Amount paid: " + money(data.paid, data.currency),
            "Balance due: " + money(data.balance, data.currency)
          );
        }

        lines.push(
          "",
          "Currency selection formats amounts only; it does not perform exchange conversion."
        );

        try {
          const text = lines.join("\n");

          if (navigator.clipboard && window.isSecureContext) {
            await navigator.clipboard.writeText(text);
          } else {
            const area = document.createElement("textarea");
            area.value = text;
            area.setAttribute("readonly", "");
            area.style.position = "fixed";
            area.style.opacity = "0";

            document.body.appendChild(area);
            area.select();

            const copied = document.execCommand("copy");
            area.remove();

            if (!copied) {
              throw new Error("Clipboard not available");
            }
          }

          showPreviewFeedback("Document summary copied.", "success");
        } catch (error) {
          showPreviewFeedback(
            "Copying was blocked by your browser. You can still print or save the document.",
            "error"
          );
        }
      }

      function csvCell(value) {
        let text = String(value ?? "");

        if (/^[\s]*[=+\-@]/.test(text)) {
          text = "'" + text;
        }

        return '"' + text.replace(/"/g, '""') + '"';
      }

      function downloadCSV() {
        if (!latestData || !latestData.identityReady) {
          return;
        }

        const data = latestData;

        const rows = [
          ["Section", "Description", "Quantity", "Unit price", "Amount", "Currency"],
          ...data.items.map(item => [
            "Line item",
            item.description,
            item.quantity,
            item.unitPrice,
            item.amount,
            data.currency
          ]),
          [],
          ["Document type", data.mode],
          ["Document number", data.number],
          ["Sender", data.businessName],
          ["Client", data.clientName],
          ["Issue date", data.issueDate],
          ["Due / validity date", data.dueDate],
          ["Subtotal", data.subtotal, "", "", "", data.currency],
          ["Discount type", data.discountType],
          ["Discount value", data.discountValue],
          ["Discount amount", data.discount, "", "", "", data.currency],
          ["Tax rate (%)", data.taxRate],
          ["Tax amount", data.tax, "", "", "", data.currency],
          ["Additional charges", data.otherCharges, "", "", "", data.currency],
          ["Total", data.total, "", "", "", data.currency]
        ];

        if (data.mode === "invoice") {
          rows.push(
            ["Amount paid", data.paid, "", "", "", data.currency],
            ["Balance due", data.balance, "", "", "", data.currency]
          );
        }

        rows.push(
          [],
          ["Note", "Review local invoice and tax requirements before use."],
          ["Note", "Currency formatting only; no currency conversion was performed."]
        );

        const csv = "\uFEFF" + rows
          .map(row => row.map(csvCell).join(","))
          .join("\r\n");

        const blob = new Blob([csv], {
          type: "text/csv;charset=utf-8;"
        });

        const url = URL.createObjectURL(blob);
        const link = document.createElement("a");

        link.href = url;
        link.download = "invoice-line-items.csv";
        link.style.display = "none";

        document.body.appendChild(link);
        link.click();
        link.remove();

        window.setTimeout(() => URL.revokeObjectURL(url), 1000);

        showPreviewFeedback("CSV export prepared for download.", "success");
      }

      function defaultDates() {
        const today = new Date();
        const due = new Date(today.getFullYear(), today.getMonth(), today.getDate() + 14);

        function toLocalDate(date) {
          return date.getFullYear() + "-" +
            String(date.getMonth() + 1).padStart(2, "0") + "-" +
            String(date.getDate()).padStart(2, "0");
        }

        issueDateInput.value = toLocalDate(today);
        dueDateInput.value = toLocalDate(due);
      }

      function loadExample() {
        documentType.value = "invoice";
        documentNumber.value = "INV-001";
        currencyInput.value = "USD";
        accentInput.value = "#3157d5";

        businessNameInput.value = "Bright Studio";
        el("businessEmail").value = "billing@example.com";
        el("businessPhone").value = "+1 555 0100";
        el("businessAddress").value = "100 Market Street\nExample City";
        el("businessTaxId").value = "";

        clientNameInput.value = "Example Client";
        el("clientEmail").value = "client@example.com";
        el("clientTaxId").value = "";
        el("clientAddress").value = "25 Business Road\nExample City";

        discountType.value = "percent";
        discountValue.value = "5";
        taxRateInput.value = "10";
        otherChargesInput.value = "15";
        amountPaidInput.value = "100";

        el("paymentInstructions").value =
          "Please pay using the payment method agreed with your service provider.";

        el("notes").value =
          "Thank you for your business. Please refer to the document number when making payment.";

        itemRows.replaceChildren();

        createItemRow({
          description: "Website design",
          quantity: 1,
          price: 450
        });

        createItemRow({
          description: "Content preparation",
          quantity: 3,
          price: 50
        });

        logoDataURL = "";
        logoFileInput.value = "";
        el("logoThumbnail").textContent = "Logo";

        setDocumentMode();
        refreshPreview();

        showFeedback(
          "Example loaded. Replace all sample business, customer and payment details before using a real invoice.",
          "info"
        );
      }

      function resetForm() {
        form.reset();
        itemRows.replaceChildren();

        logoDataURL = "";
        logoFileInput.value = "";
        el("logoThumbnail").textContent = "Logo";

        defaultDates();

        documentType.value = "invoice";
        documentNumber.value = "INV-001";
        currencyInput.value = "USD";
        accentInput.value = "#3157d5";
        discountType.value = "percent";
        discountValue.value = "0";
        taxRateInput.value = "0";
        otherChargesInput.value = "0";
        amountPaidInput.value = "0";

        createItemRow({
          description: "",
          quantity: 1,
          price: 0
        });

        setDocumentMode();
        clearFeedback();
        clearPreviewFeedback();
        refreshPreview();

        showFeedback(
          "Form reset. Enter your own invoice details to begin.",
          "info"
        );
      }

      function updateDiscountLabel() {
        if (discountType.value === "percent") {
          el("discountLabel").textContent = "Discount (%)";
          discountValue.max = "100";
        } else {
          el("discountLabel").textContent =
            "Fixed discount (" + currencyInput.value + ")";
          discountValue.max = String(MAX_FIELD_AMOUNT);
        }
      }

      addItemButton.addEventListener("click", () => {
        if (createItemRow({
          description: "",
          quantity: 1,
          price: 0
        })) {
          refreshPreview();
        }
      });

      form.addEventListener("input", () => {
        if (updating) return;

        clearFeedback();
        refreshPreview();
      });

      form.addEventListener("change", () => {
        setDocumentMode();
        updateDiscountLabel();
        refreshPreview();
      });

      prepareButton.addEventListener("click", prepareDocument);

      document.getElementById("exampleButton")
        .addEventListener("click", loadExample);

      document.getElementById("resetButton")
        .addEventListener("click", resetForm);

      copyButton.addEventListener("click", copySummary);
      downloadCSVButton.addEventListener("click", downloadCSV);

      printButton.addEventListener("click", () => {
        if (!latestData || !latestData.identityReady) {
          prepareDocument();
          return;
        }

        window.print();
      });

      logoFileInput.addEventListener("change", () => {
        const file = logoFileInput.files && logoFileInput.files[0];

        if (!file) {
          return;
        }

        const allowedTypes = [
          "image/png",
          "image/jpeg",
          "image/webp"
        ];

        if (!allowedTypes.includes(file.type)) {
          showFeedback(
            "Use a PNG, JPEG or WebP image for your logo.",
            "error"
          );
          logoFileInput.value = "";
          return;
        }

        if (file.size > MAX_LOGO_BYTES) {
          showFeedback("The logo file must be 1 MiB or smaller.", "error");
          logoFileInput.value = "";
          return;
        }

        const reader = new FileReader();

        reader.addEventListener("load", () => {
          if (typeof reader.result !== "string") {
            showFeedback("The selected logo could not be read.", "error");
            return;
          }

          logoDataURL = reader.result;

          const thumbnail = el("logoThumbnail");
          thumbnail.replaceChildren();

          const image = document.createElement("img");
          image.src = logoDataURL;
          image.alt = "Selected logo preview";

          thumbnail.appendChild(image);

          refreshPreview();

          showFeedback(
            "Logo loaded locally. It has not been uploaded by this tool.",
            "success"
          );
        });

        reader.addEventListener("error", () => {
          showFeedback("Unable to read the selected logo file.", "error");
        });

        reader.readAsDataURL(file);
      });

      document.getElementById("removeLogo").addEventListener("click", () => {
        logoDataURL = "";
        logoFileInput.value = "";
        el("logoThumbnail").textContent = "Logo";
        refreshPreview();
      });

      // All user-provided text is inserted with textContent rather than
      // interpreting it as HTML.
      defaultDates();
      createItemRow({
        description: "Service or product",
        quantity: 1,
        price: 0
      });

      setDocumentMode();
      updateDiscountLabel();
      refreshPreview();

      document.getElementById("copyrightYear").textContent =
        String(new Date().getFullYear());
    })();
  </script>
</body>
